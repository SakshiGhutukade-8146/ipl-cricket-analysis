from pathlib import Path

import matplotlib.pyplot as plt
import pandas as pd
import seaborn as sns


DATA_PATH = Path(__file__).resolve().parents[1] / "data" / "ipl_matches_sample.csv"
OUTPUT_DIR = Path(__file__).resolve().parents[1] / "outputs"
OUTPUT_DIR.mkdir(exist_ok=True)


def load_data():
    df = pd.read_csv(DATA_PATH)
    df["date"] = pd.to_datetime(df["date"])
    return df


def get_team_wins(df):
    team_wins = df["match_winner"].value_counts().reset_index()
    team_wins.columns = ["team", "wins"]
    team_wins = team_wins.sort_values("wins", ascending=False)
    return team_wins


def get_toss_and_match_win_summary(df):
    toss_wins = df[df["toss_winner"] == df["match_winner"]].shape[0]
    total_matches = len(df)
    return {
        "total_matches": total_matches,
        "matches_won_after_toss_win": toss_wins,
        "percentage": round((toss_wins / total_matches) * 100, 2),
    }


def get_team_season_summary(df):
    season_summary = df.groupby(["season", "match_winner"]).size().reset_index(name="wins")
    return season_summary


def plot_team_wins(team_wins):
    plt.figure(figsize=(10, 6))
    sns.barplot(data=team_wins.head(8), x="wins", y="team", palette="viridis")
    plt.title("Top IPL Teams by Match Wins")
    plt.xlabel("Number of Wins")
    plt.ylabel("Team")
    plt.tight_layout()
    plt.savefig(OUTPUT_DIR / "team_wins.png", dpi=300)
    plt.close()


def print_summary(df):
    team_wins = get_team_wins(df)
    summary = get_toss_and_match_win_summary(df)
    season_summary = get_team_season_summary(df)

    print("IPL Cricket Data Analysis Summary")
    print("=" * 40)
    print("\nTop Teams by Wins:")
    print(team_wins.head(10).to_string(index=False))

    print("\nToss and Match Outcome Analysis:")
    print(f"Total matches: {summary['total_matches']}")
    print(f"Matches won by the toss winner: {summary['matches_won_after_toss_win']}")
    print(f"Percentage of toss winners winning the match: {summary['percentage']}%")

    print("\nSeason-wise Match Winners:")
    print(season_summary.to_string(index=False))


def main():
    df = load_data()
    print_summary(df)
    team_wins = get_team_wins(df)
    plot_team_wins(team_wins)
    print(f"\nSaved chart to: {OUTPUT_DIR / 'team_wins.png'}")


if __name__ == "__main__":
    main()
